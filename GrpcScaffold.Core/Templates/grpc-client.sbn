{{~ for ns in usings ~}}
using {{ ns }};
{{~ end ~}}

namespace {{ client_namespace }};

public sealed class {{ client_class_name }}
{
    private readonly {{ proto_namespace }}.{{ service_name }}.{{ service_name }}Client _client;

    public {{ client_class_name }}(
        {{ proto_namespace }}.{{ service_name }}.{{ service_name }}Client client)
    {
        _client = client;
    }

{{~ for rpc in rpcs }}

    public async Task<Result{{ if rpc.response }}<{{ rpc.response_type }}>{{ end }}> {{ rpc.rpc_name }}Async(
        {{ if rpc.request }}{{ rpc.request_type }} request,{{ end }}
        CancellationToken cancellationToken = default)
    {
        try
        {
{{ if rpc.request }}
            var grpcRequest =
                {{ mapping_namespace }}.{{ rpc.mapping_class_name }}.MapToGrpc(request);
{{ else }}
            var grpcRequest = new Empty();
{{ end }}

{{ if rpc.response }}
            var grpcResponse =
                await _client.{{ rpc.rpc_name }}Async(
                    grpcRequest,
                    cancellationToken: cancellationToken);

            var response =
                {{ mapping_namespace }}.{{ rpc.mapping_class_name }}.MapToResponse(
                    grpcResponse);

            return Result.Success(response);
{{ else }}
            await _client.{{ rpc.rpc_name }}Async(
                grpcRequest,
                cancellationToken: cancellationToken);

            return Result.Success();
{{ end }}
        }
        catch (RpcException ex)
        {
{{ if rpc.response }}
            return ex.ToResult<{{ rpc.response_type }}>();
{{ else }}
            return ex.ToResult();
{{ end }}
        }
    }
{{~ end }}
}
