{{~ # src/GrpcScaffold.Core/Templates/service.proto.sbn ~}}
// <auto-generated>
//   Generated by grpc-scaffold. Do not edit by hand — re-run the tool instead.
//   Source endpoint: {{ endpoint_class_name }}
// </auto-generated>
syntax = "proto3";

package {{ proto_package }}.{{ service_name }};
option csharp_namespace = "{{ csharp_namespace }}.{{ service_name }}";

{{~ for proto_import in proto_imports ~}}
import "{{ proto_import }}";
{{~ end ~}}


service {{ service_name }} {
{{~ for rpc in rpcs ~}}
  rpc {{ rpc.rpc_name }} ({{ rpc.request?.Name ?? "google.protobuf.Empty" }}) returns ({{ rpc.response?.Name ?? "google.protobuf.Empty" }});
{{~ end ~}}
}

{{~ for enum in enums ~}}
enum {{ enum.name }} {
{{ for value in enum.values }}
    {{ value.name }} = {{ value.number }};{{ end }}
}
{{ end }}

{{~ for message in messages ~}}
message {{ message.name }} {
{{~ for field in message.fields ~}}
{{ if field.is_map }}
  map<{{ field.map_key_type }}, {{ field.map_value_type }}> {{ field.proto_name }} = {{ field.field_number }};
{{ else if field.is_repeated }}
  repeated {{ field.proto_type_name }} {{ field.proto_name }} = {{ field.field_number }};
{{ else if field.is_nullable }}
  optional {{ field.proto_type_name }} {{ field.proto_name }} = {{ field.field_number }};
{{ else }}
  {{ field.proto_type_name }} {{ field.proto_name }} = {{ field.field_number }};
{{ end }}
{{~ end ~}}
}
{{~ end ~}}

