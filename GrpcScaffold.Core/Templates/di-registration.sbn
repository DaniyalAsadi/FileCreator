{{~ # src/GrpcScaffold.Core/Templates/di-registration.sbn ~}}
{{~ if registration_kind == "client" ~}}
// <auto-generated>
//   Generated by grpc-scaffold. Additive — safe to regenerate.
//   Registers generated BFF gRPC clients. Call from Program.cs:
//     services.AddGrpcScaffoldClients(configuration);
// </auto-generated>
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using System;

namespace {{ grpc_namespace }};

public static class GrpcClientRegistration
{
    public static IServiceCollection AddGrpcScaffoldClients(
        this IServiceCollection services,
        IConfiguration configuration)
    {
{{~ for service in client_services ~}}
        services.AddGrpcClient<{{ service.proto_namespace }}.{{ service.service_name }}.{{ service.service_name }}Client>((_, options) =>
        {
            var address = configuration["{{ configuration_section }}:{{ service.service_name }}:Address"]
                ?? configuration["{{ configuration_section }}:Default:Address"];

            if (string.IsNullOrWhiteSpace(address))
            {
                throw new InvalidOperationException(
                    "Missing gRPC client address configuration for service '{{ service.service_name }}'. " +
                    "Configure '{{ configuration_section }}:{{ service.service_name }}:Address' or '{{ configuration_section }}:Default:Address'.");
            }

            options.Address = new Uri(address);
        });
        services.AddScoped<{{ service.client_namespace }}.{{ service.client_class_name }}>();
{{~ end ~}}
        return services;
    }
}
{{~ else ~}}
// <auto-generated>
//   Generated by grpc-scaffold. Additive — safe to regenerate.
//   Registers every generated gRPC service. Call from Program.cs:
//     app.MapGrpcScaffoldServices();
// </auto-generated>
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Routing;

namespace {{ grpc_namespace }};

public static class GrpcServiceRegistration
{
    public static IEndpointRouteBuilder MapGrpcScaffoldServices(this IEndpointRouteBuilder endpoints)
    {
{{~ for service in services ~}}
        endpoints.MapGrpcService<{{ grpc_namespace }}.Services.{{ service }}GrpcService>();
{{~ end ~}}
        return endpoints;
    }
}
{{~ end ~}}
