<Window x:Class="FileCreator.PreviewForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Generated Files"
        Width="1100" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="Gainsboro"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="tabs" Grid.Row="0"
                    Background="#1E1E1E" BorderThickness="0" />

        <Border Grid.Row="1" Background="#1E1E1E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOk" Content="Generate"
                        Width="100" Height="32" Margin="0,0,10,0"
                        Background="#007ACC" Foreground="White" BorderThickness="0"
                        IsDefault="True"
                        Click="BtnOk_Click" />
                <Button x:Name="btnCancel" Content="Cancel"
                        Width="100" Height="32"
                        Background="#464646" Foreground="White" BorderThickness="0"
                        IsCancel="True"
                        Click="BtnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
