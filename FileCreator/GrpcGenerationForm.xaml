<Window x:Class="FileCreator.GrpcGenerationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gRPC Scaffold Generator"
        Width="900" Height="820"
        MinWidth="700" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="Gainsboro"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid>
      <Grid x:Name="grpcContent" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Group name selector -->
        <ComboBox x:Name="cmbGroupName" Grid.Row="0" Height="34" FontSize="13"
                  SelectionChanged="CmbGroupName_SelectionChanged" />

        <!-- Endpoint filter -->
        <TextBox x:Name="txtEndpointFilter" Grid.Row="2" Height="34" FontSize="13"
                 VerticalContentAlignment="Center"
                 Tag="Endpoint Filter (*User*)"
                 TextChanged="TxtEndpointFilter_TextChanged" />

        <!-- Option checkboxes -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="chkGenerateAll" Grid.Row="0" Grid.Column="0" Content="Generate All" FontSize="13" />
            <CheckBox x:Name="chkInternalOnly" Grid.Row="0" Grid.Column="2" Content="Internal Only" FontSize="13" />

            <CheckBox x:Name="chkDryRun" Grid.Row="2" Grid.Column="0" Content="Dry Run" FontSize="13" />
            <CheckBox x:Name="chkForce" Grid.Row="2" Grid.Column="2" Content="Force" FontSize="13" />
            <CheckBox x:Name="chkStrict" Grid.Row="2" Grid.Column="4" Content="Strict" FontSize="13" />
        </Grid>

        <!-- Endpoints grid -->
        <DataGrid x:Name="dgvEndpoints" Grid.Row="6"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="34"
                  FontSize="13"
                  Background="#252526"
                  Foreground="Gainsboro"
                  RowBackground="#2D2D30"
                  AlternatingRowBackground="#252526"
                  BorderBrush="#3F3F46"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="44">
                    <DataGridCheckBoxColumn.Header>
                        <CheckBox x:Name="chkSelectAll" Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed" />
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Name}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Verb" Binding="{Binding HttpVerb}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Response" Binding="{Binding ResponseType}" Width="140" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Generate button -->
        <Button x:Name="btnGenerateGrpc" Grid.Row="8" Height="46" FontSize="14"
                Content="Generate gRPC"
                Background="#007ACC" Foreground="White" BorderThickness="0"
                Click="BtnGenerateGrpc_Click" />
      </Grid>

      <Grid x:Name="loadingOverlay"
            Visibility="Collapsed"
            Background="#D91E1E1E">
        <Border Width="440"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Loading gRPC project..."
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,20" />

            <Grid>
              <ProgressBar x:Name="loadingProgressBar"
                           Height="22"
                           Minimum="0"
                           Maximum="100"
                           Value="0" />
              <TextBlock x:Name="loadingPercentageText"
                         Text="0%"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Foreground="White" />
            </Grid>

            <TextBlock x:Name="loadingStageText"
                       Text="Preparing endpoint discovery"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,6"
                       FontSize="15"
                       Foreground="Gainsboro" />

            <TextBlock x:Name="loadingDetailText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#B8B8B8"
                       MaxWidth="380"
                       Margin="0,0,0,18" />

            <Button x:Name="btnCancelLoading"
                    Content="Cancel"
                    Width="110"
                    Height="34"
                    HorizontalAlignment="Center"
                    Background="#3F3F46"
                    Foreground="White"
                    BorderThickness="0"
                    Click="BtnCancelLoading_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
</Window>
