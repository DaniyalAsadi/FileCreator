<Window x:Class="FileCreator.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="430" Height="140"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="Gainsboro"
        FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="txtSolutionPath" Grid.Row="0" Grid.Column="0"
                 IsReadOnly="True" Height="26" VerticalContentAlignment="Center" />

        <Button x:Name="btnBrowse" Grid.Row="0" Grid.Column="2"
                Content="Browse" Width="80" Height="26"
                Click="BtnBrowse_Click" />

        <Button x:Name="btnSave" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Content="Save" Height="30"
                Background="#007ACC" Foreground="White" BorderThickness="0"
                Click="BtnSave_Click" />
    </Grid>
</Window>
